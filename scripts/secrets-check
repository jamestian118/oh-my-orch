#!/usr/bin/env bash
set -euo pipefail

# scripts/secrets-check
# 说明：最小 secrets 扫描（启发式，偏保守）
# 注意：可能误报；若误报，优先改为更精确规则或引入专用 secrets 扫描工具（仍通过 scripts/ 与 CI 入口统一调用）

PATTERNS=(
  "BEGIN PRIVATE KEY"
  "AKIA[0-9A-Z]{16}"      # AWS Access Key ID（启发式）
  "xoxb-"                 # Slack bot token（前缀）
  "xoxp-"                 # Slack user token（前缀）
  "ghp_"                  # GitHub token（前缀）
)

EXCLUDE_DIRS=(
  ".git"
  ".venv"
  "venv"
  "node_modules"
  "dist"
  "build"
  "coverage"
)

exclude_args=()
for d in "${EXCLUDE_DIRS[@]}"; do
  exclude_args+=( "--exclude-dir=$d" )
done
exclude_args+=( "--exclude=secrets-check" )

hit=0
for p in "${PATTERNS[@]}"; do
  # -R: recursive, -n: line numbers, -I: ignore binary, -E: extended regex
  if grep -RInIE "${exclude_args[@]}" "$p" . >/dev/null 2>&1; then
    echo "[secrets-check] ❌ potential secret match: pattern='$p'"
    grep -RInIE "${exclude_args[@]}" "$p" . | head -n 50
    hit=1
  fi
done

if [[ "$hit" -ne 0 ]]; then
  echo "[secrets-check] FAIL"
  exit 1
fi

echo "[secrets-check] OK"
